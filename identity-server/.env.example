# Dedicated trusted issuer wallet. Must correspond to IDENTITY_ISSUER_ADDRESS in the deployment.
IDENTITY_ISSUER_PRIVATE_KEY=replace-with-a-dedicated-identity-issuer-private-key
IDENTITY_ISSUER_ADDRESS=0xIdentityIssuerWallet
IDENTITY_VOTING_CONTRACT_ADDRESS=0xDeployedZKVotingContract
IDENTITY_CHAIN_ID=11155111
IDENTITY_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
IDENTITY_COMMITMENT_SECRET=replace-with-a-random-secret-at-least-32-bytes
IDENTITY_PROVIDER_SESSION_URL=https://identity-provider.example/api/sessions
IDENTITY_PROVIDER_RESULT_URL=https://identity-provider.example/api/verification-results
IDENTITY_PROVIDER_API_KEY=configure-from-your-authorized-provider
IDENTITY_FRONTEND_ORIGIN=http://localhost:5173
IDENTITY_PROVIDER_RETURN_URL=http://localhost:5173
IDENTITY_PORT=3001
