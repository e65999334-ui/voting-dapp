# Sepolia deployment: use a NEW wallet key. Never reuse the previously exposed deployer key.
# Local Hardhat tests use ephemeral accounts and need no private key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=replace-with-a-new-sepolia-wallet-private-key
GOVERNANCE_MEMBERS=0xFirstGovernanceWallet,0xSecondGovernanceWallet
GOVERNANCE_THRESHOLD=2

# Identity issuer address used as a constructor argument during deployment.
IDENTITY_ISSUER_ADDRESS=0xIdentityIssuerWallet